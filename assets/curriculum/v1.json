          "correctIndex": 1,
          "explanation": "आ is the long \"ā\" vowel."
        },
        {
          "id": "q_alpha_2",
          "difficulty": "beginner",
          "prompt": "How many vowels are in the Sanskrit alphabet?",
          "options": ["10", "13", "16", "20"],
          "correctIndex": 1,
          "explanation": "Sanskrit has 13 vowels (स्वराः)."
        },
        {
          "id": "q_alpha_3",
          "difficulty": "beginner",
          "prompt": "Which is a consonant (व्यञ्जन)?",
          "options": ["अ", "क", "आ", "ई"],
          "correctIndex": 1,
          "explanation": "क (ka) is a velar consonant."
        },
        {
          "id": "q_alpha_4",
          "difficulty": "beginner",
          "prompt": "Which of these is a vowel?",
          "options": ["\u0915", "\u0906", "\u092A", "\u092E"],
          "correctIndex": 1,
          "explanation": "\u0906 (aa) is the long vowel \"a\"."
        },
        {
          "id": "q_alpha_5",
          "difficulty": "beginner",
          "prompt": "How many consonants does Sanskrit have?",
          "options": ["23", "33", "43", "53"],
          "correctIndex": 1,
          "explanation": "Sanskrit has 33 consonants organized into 5 groups (vargas)."
        },
        {
          "id": "q_alpha_6",
          "difficulty": "intermediate",
          "prompt": "Which speech group does \u0915 (ka) belong to?",
          "options": ["Dentals", "Velars", "Labials", "Retroflex"],
          "correctIndex": 1,
          "explanation": "\u0915 (ka) is a velar - produced at the back of the throat."
        },
        {
          "id": "q_alpha_7",
          "difficulty": "intermediate",
          "prompt": "In barakhadi, which matra attaches on the LEFT of a consonant?",
          "options": ["Long a (\u093E)", "Short i (\u093F)", "Short u (\u0941)", "Long u (\u0942)"],
          "correctIndex": 1,
          "explanation": "The short-i matra (\u093F) is the only one written on the left of a consonant."
        }
      ]
    },
