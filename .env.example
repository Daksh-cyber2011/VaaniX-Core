# ============================================================
# VaaniX App — Environment Variables
# Copy this file to assets/env/.env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# ------------------------------------------------------------
# Supabase Configuration
# Get these from: https://app.supabase.com → Project Settings → API
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------
# VaaniX FastAPI Backend
# Local development: http://localhost:8000
# Production: https://api.vaanix.app (update when deployed)
# ------------------------------------------------------------
API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------
APP_ENV=development
# Options: development | staging | production

# ------------------------------------------------------------
# Sentry Crash Reporting (optional — leave empty for local dev)
# Get your DSN from: https://sentry.io → Project Settings → Client Keys
# If empty, Sentry runs in no-op mode (safe for local development).
# ------------------------------------------------------------
SENTRY_DSN=

# ------------------------------------------------------------
# Google Gemini API Key (optional — leave empty for offline mode)
# Get your key from: https://aistudio.google.com/app/apikey
# If empty, the AI module falls back to the OfflineModelAdapter
# (canned responses, not real AI). Required for real AI chat.
# ------------------------------------------------------------
GEMINI_API_KEY=
