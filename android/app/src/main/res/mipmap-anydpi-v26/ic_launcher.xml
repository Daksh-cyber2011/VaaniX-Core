<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Legacy raster mipmaps below API 26
     remain in mipmap-*/ic_launcher.png. The foreground reuses the existing
     launcher art inset into the adaptive safe zone; the background is the
     app's warm light surface color so the icon matches the product theme. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
