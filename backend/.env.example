# VaaniX Backend — environment variables
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ----- Required ---------------------------------------------------------------

# Secret used to sign and verify backend-issued tokens.
# Must be ≥ 32 characters in production.
VAANIX_BACKEND_SECRET=change-me-this-is-a-development-secret-32chars

# Supabase project URL — public. e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase SERVICE-ROLE key — PRIVILEGED. Must NEVER be shipped to Flutter.
# The anon key is safe to ship; the service-role key is NOT.
SUPABASE_SERVICE_ROLE_KEY=ey...replace-me-service-role-key...

# Provider keys — these must NEVER appear in the Flutter app in production.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.8-flash

# ----- Optional ---------------------------------------------------------------

VAANIX_ENV=development           # one of: development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_HOUR_PER_USER=60
